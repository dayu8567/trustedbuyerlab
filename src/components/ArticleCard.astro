---
import type { ArticleSummary } from "../data/blog";
import { CATEGORIES, FORMATS } from "../data/taxonomy";

interface Props {
  article: ArticleSummary;
}

const { article } = Astro.props;
---

<article class="article-card">
  <a class="article-card-media" href={article.href} tabindex="-1" aria-hidden="true">
    <img
      src={article.image}
      alt={article.imageAlt}
      width="800"
      height="500"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="article-card-body">
    <p class="article-meta">
      <span>{CATEGORIES[article.category].label}</span>
      <span>{FORMATS[article.format].label}</span>
      <span>{article.readingTime}</span>
    </p>
    <h3><a href={article.href}>{article.title}</a></h3>
    <p>{article.description}</p>
    <a class="text-link" href={article.href}>
      {article.format === "deals" ? "Read the price brief" : "Read the guide"}
    </a>
  </div>
</article>
