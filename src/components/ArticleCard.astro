---
import { Image } from "astro:assets";
import type { ArticleSummary } from "../data/blog";
import { SECTIONS } from "../data/blog";

interface Props {
  article: ArticleSummary;
}

const { article } = Astro.props;
---

<article class="article-card">
  <a class="article-card-media" href={article.href} tabindex="-1" aria-hidden="true">
    <Image
      src={article.image}
      alt={article.imageAlt}
      widths={[360, 560, 760]}
      sizes="(max-width: 720px) 100vw, (max-width: 1040px) 50vw, 33vw"
      format="webp"
      quality={70}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="article-card-body">
    <p class="article-meta">
      <span>{SECTIONS[article.category].label}</span>
      <span>{article.readingTime}</span>
    </p>
    <h3><a href={article.href}>{article.title}</a></h3>
    <p>{article.description}</p>
    <a class="text-link" href={article.href}>Read guide</a>
  </div>
</article>
