---
import type { ArticleSummary } from "../data/blog";
import { CATEGORIES, FORMATS } from "../data/taxonomy";

interface Props {
  article: ArticleSummary;
  priority?: boolean;
}

const { article, priority = false } = Astro.props;
---

<article class="feature-story">
  <a class="feature-story-media" href={article.href} tabindex="-1" aria-hidden="true">
    <img
      src={article.image}
      alt={article.imageAlt}
      width="1200"
      height="750"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
    />
  </a>
  <div class="feature-story-body">
    <p class="article-kicker">{article.kicker}</p>
    <h2><a href={article.href}>{article.title}</a></h2>
    <p>{article.description}</p>
    <p class="article-meta">
      <span>{CATEGORIES[article.category].label}</span>
      <span>{FORMATS[article.format].label}</span>
      <span>{article.dateLabel}</span>
      <span>{article.readingTime}</span>
    </p>
    <a class="button" href={article.href}>
      {article.format === "deals" ? "See the price details" : "Read the guide"}
    </a>
  </div>
</article>
