---
import { SITE, disclosure } from "../data/site";
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <strong>Trusted Buyer Lab</strong>
        <p>
          Research-led buying guides and practical explainers for pool owners.
          Specifications and retailer availability can change, so confirm
          details before purchase.
        </p>
        <p>{disclosure}</p>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Explore</p>
        <nav class="footer-links" aria-label="Footer navigation">
          {SITE.navigation.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Legal</p>
        <nav class="footer-links" aria-label="Legal links">
          {SITE.legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 Trusted Buyer Lab</span>
      <span>Independent research. No hands-on testing claims.</span>
    </div>
  </div>
</footer>
