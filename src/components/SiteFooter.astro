---
import { SITE, disclosure } from "../data/site";
import { CATEGORIES } from "../data/taxonomy";
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <strong>Trusted Buyer Lab</strong>
        <p>
          Research-led appliance guides, maintenance explainers, and
          time-stamped price briefs for a more considered home.
        </p>
        <p>{disclosure}</p>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Explore</p>
        <nav class="footer-links" aria-label="Footer navigation">
          {SITE.navigation.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Categories</p>
        <nav class="footer-links" aria-label="Footer categories">
          {
            Object.values(CATEGORIES).map((category) => (
              <a href={category.href}>{category.label}</a>
            ))
          }
        </nav>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Legal</p>
        <nav class="footer-links" aria-label="Legal links">
          {SITE.legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href="/image-credits/">Image credits</a>
          <a href="/feed.xml">RSS feed</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 Trusted Buyer Lab</span>
      <span>Desk research is disclosed. No unverified hands-on claims.</span>
    </div>
  </div>
</footer>
