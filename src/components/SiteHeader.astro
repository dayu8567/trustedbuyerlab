---
import { SITE } from "../data/site";
import { CATEGORIES } from "../data/taxonomy";

const path = Astro.url.pathname;
const categories = Object.values(CATEGORIES);
const isActive = (href: string) =>
  path === href || (href !== "/" && path.startsWith(href));
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Trusted Buyer Lab home">
      <span class="brand-mark" aria-hidden="true">TBL</span>
      <span>Trusted Buyer Lab</span>
    </a>
    <nav class="nav-links" aria-label="Primary navigation">
      {
        SITE.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <details class="mobile-menu">
      <summary>
        <span>Browse</span>
        <span class="menu-icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </summary>
      <div class="mobile-menu-panel">
        <nav aria-label="Mobile navigation">
          {
            SITE.navigation.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <p class="mobile-menu-heading">Appliance categories</p>
        <nav class="mobile-category-links" aria-label="Appliance categories">
          {
            categories.map((category) => (
              <a href={category.href}>{category.label}</a>
            ))
          }
        </nav>
      </div>
    </details>
  </div>
  <nav class="category-bar" aria-label="Appliance categories">
    <div class="container">
      {
        categories.map((category) => (
          <a
            href={category.href}
            aria-current={path.startsWith(category.href) ? "page" : undefined}
          >
            {category.shortLabel}
          </a>
        ))
      }
    </div>
  </nav>
</header>
