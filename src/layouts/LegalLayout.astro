---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  updated?: string;
}

const { title, description, canonicalPath, updated = "October 25, 2026" } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <Breadcrumbs
    items={[
      { href: "/", label: "Home" },
      { label: title },
    ]}
  />
  <section class="legal-head">
    <div class="narrow">
      <h1>{title}</h1>
      <p>Last updated: {updated}</p>
    </div>
  </section>
  <section class="legal-page">
    <article class="legal-body narrow">
      <slot />
    </article>
  </section>
</BaseLayout>
