---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found. Browse the Trusted Buyer Lab pool care and buying guide library."
  canonicalPath="/404.html"
  noindex
>
  <section class="not-found">
    <div class="container">
      <p class="code">404</p>
      <h1>That page is out of the pool.</h1>
      <p>
        The link may be outdated. Browse the current guide library or start
        with the latest pool robot comparison.
      </p>
      <div class="verdict-actions center-actions">
        <a class="button" href="/best-cordless-robotic-pool-cleaners/">
          See the 2026 comparison
        </a>
        <a class="button secondary" href="/">Return home</a>
      </div>
    </div>
  </section>
</BaseLayout>
