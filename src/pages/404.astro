---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found. Browse the Trusted Buyer Lab home appliance library."
  canonicalPath="/404.html"
  noindex
>
  <section class="not-found">
    <div class="container">
      <p class="code">404</p>
      <h1>That page left the building.</h1>
      <p>
        The link may be outdated. Browse the current appliance library by room,
        product family, or editorial format.
      </p>
      <div class="verdict-actions center-actions">
        <a class="button" href="/categories/">Browse categories</a>
        <a class="button secondary" href="/">Return home</a>
      </div>
    </div>
  </section>
</BaseLayout>
