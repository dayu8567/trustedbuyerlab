---
import ArticleFeature from "../../components/ArticleFeature.astro";
import ArticleGrid from "../../components/ArticleGrid.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  SECTIONS,
  type ArticleSummary,
  type SectionKey,
} from "../../data/blog";
import { SITE } from "../../data/site";
import { getAllArticles } from "../../lib/articles";

export async function getStaticPaths() {
  const allArticles = await getAllArticles();
  const sectionKeys = Object.keys(SECTIONS) as SectionKey[];

  return sectionKeys.map((section) => ({
    params: { section },
    props: {
      sectionArticles: allArticles.filter(
        (article) => article.category === section,
      ),
      totalCount: allArticles.length,
    },
  }));
}

interface Props {
  sectionArticles: ArticleSummary[];
  totalCount: number;
}

const { sectionArticles, totalCount } = Astro.props;
const section = Astro.params.section as SectionKey;
const definition = SECTIONS[section];
const featured = sectionArticles[0];
const rest = sectionArticles.slice(1);
const sectionKeys = Object.keys(SECTIONS) as SectionKey[];
const title = `${definition.label} guides`;
const description = `${definition.description} Browse ${sectionArticles.length} research-led ${definition.label.toLowerCase()} articles from Trusted Buyer Lab.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE.url}${definition.href}#collection`,
  url: `${SITE.url}${definition.href}`,
  name: title,
  description,
  inLanguage: "en",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: sectionArticles.length,
    itemListElement: sectionArticles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE.url}${article.href}`,
      name: article.title,
    })),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={definition.href}
  schema={schema}
>
  <Breadcrumbs
    items={[
      { href: "/", label: "Home" },
      { href: "/guides/", label: "All guides" },
      { label: definition.label },
    ]}
  />

  <header class="section-intro">
    <div class="container section-intro-grid">
      <div>
        <p class="eyebrow">{definition.eyebrow}</p>
        <h1>{definition.label}</h1>
        <p class="hero-lede">{definition.description}</p>
      </div>
      <aside class="section-facts" aria-label={`${definition.label} section details`}>
        <div>
          <strong>{sectionArticles.length}</strong>
          <span>Guides in this section</span>
        </div>
        <div>
          <strong>{totalCount}</strong>
          <span>Guides in the full library</span>
        </div>
      </aside>
    </div>
  </header>

  <nav class="section-tabs" aria-label="Switch guide section">
    <div class="container">
      <a href="/guides/">All guides</a>
      {sectionKeys.map((key) => (
        <a
          href={SECTIONS[key].href}
          aria-current={key === section ? "page" : undefined}
        >
          {SECTIONS[key].label}
        </a>
      ))}
    </div>
  </nav>

  {
    featured ? (
      <>
        <section class="section paper">
          <div class="container">
            <div class="section-header">
              <div>
                <p class="eyebrow">Latest in {definition.label.toLowerCase()}</p>
                <h2>Lead guide</h2>
              </div>
              <p>{featured.description}</p>
            </div>
            <ArticleFeature article={featured} priority />
          </div>
        </section>

        <section class="section">
          <div class="container">
            <div class="section-header">
              <div>
                <p class="eyebrow">Continue reading</p>
                <h2>More {definition.label.toLowerCase()} guides</h2>
              </div>
              <p>Follow the question, not a fixed product feed.</p>
            </div>
            <ArticleGrid
              articles={rest}
              emptyMessage="The next guide in this section is in progress."
            />
          </div>
        </section>
      </>
    ) : (
      <section class="section paper">
        <div class="container">
          <p class="section-empty">The first guide in this section is in progress.</p>
        </div>
      </section>
    )
  }
</BaseLayout>
