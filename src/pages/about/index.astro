---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CATEGORIES, type CategoryKey } from "../../data/taxonomy";
import { SITE, disclosure } from "../../data/site";
import { getAllArticles } from "../../lib/articles";

const articles = await getAllArticles();
const categoryKeys = Object.keys(CATEGORIES) as CategoryKey[];
const title = "About Trusted Buyer Lab";
const description =
  "Learn how Trusted Buyer Lab researches household appliances, labels automated price briefs, and separates desk research from hands-on testing.";
const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${SITE.url}/about/#about`,
  url: `${SITE.url}/about/`,
  name: title,
  description,
  inLanguage: "en",
  mainEntity: {
    "@type": "Organization",
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
  },
};
---

<BaseLayout title={title} description={description} canonicalPath="/about/" schema={schema}>
  <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "About" }]} />
  <header class="about-hero">
    <div class="container about-hero-grid">
      <div>
        <p class="eyebrow">About the lab</p>
        <h1>Useful research for the part after the product photo.</h1>
      </div>
      <p class="about-standfirst">
        Trusted Buyer Lab is an independent editorial site for household
        appliances. We focus on fit, tradeoffs, maintenance, installation, and
        the details that remain important after a purchase.
      </p>
    </div>
  </header>

  <section class="section paper">
    <div class="narrow about-body">
      <div class="about-statline">
        <div><strong>{articles.length}</strong><span>Published articles</span></div>
        <div><strong>5</strong><span>Appliance categories</span></div>
        <div><strong>2026</strong><span>Current edition</span></div>
      </div>

      <h2>Why the library is organized by decisions</h2>
      <p>
        A washing machine or robot vacuum is not one purchase with one right
        answer. Room size, installation, noise, capacity, maintenance, and the
        work you want to stop doing all change the sensible choice. The site
        separates those questions into categories and editorial formats so a
        reader can start with the problem instead of a product name.
      </p>
      <div class="about-section-list">
        {categoryKeys.map((key) => (
          <a href={CATEGORIES[key].href}>
            <span>{CATEGORIES[key].label}</span>
            <p>{CATEGORIES[key].description}</p>
          </a>
        ))}
      </div>

      <h2>How research is framed</h2>
      <p>
        Articles compare published manufacturer specifications, official
        documentation, safety information, and ownership constraints. We
        distinguish those sources from our own judgment and avoid presenting
        desk research as hands-on laboratory testing.
      </p>
      <p>
        A specification is useful only when it maps to a real room and routine.
        The editorial approach explains those relationships, shows where the
        available evidence stops, and recommends confirming current retailer
        details before purchase.
      </p>

      <h2>Automated price briefs</h2>
      <p>
        The newsroom collects structured offer data from an approved affiliate
        feed. Deterministic code writes the product name, price, timestamp,
        listed price, availability, and affiliate link. Workers AI may help
        draft explanatory prose, but it does not invent the offer facts.
      </p>
      <p>
        A brief publishes only after price consistency, source URL, prohibited
        claims, duplicate title, daily cap, and production build checks pass.
        Automated briefs are labeled on the article page and kept separate from
        human-reviewed reviews and buying guides.
      </p>

      <h2>Independence and affiliate links</h2>
      <p>{disclosure}</p>
      <p>
        Commercial relationships do not determine the structure of a guide.
        Outbound commercial links use <code>nofollow sponsored</code>, and
        price snapshots always include a verification time.
      </p>

      <h2>Corrections</h2>
      <p>
        Appliance specifications and retailer availability can change. A
        correction begins with the source currently cited on the page and the
        date the claim was checked. The goal is not to appear infallible, but
        to leave a clear trail when the evidence changes.
      </p>
      <p class="about-signoff">- The Trusted Buyer Lab editorial desk</p>
    </div>
  </section>
</BaseLayout>
