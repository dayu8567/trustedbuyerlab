---
import { render, type CollectionEntry } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../data/blog";
import { LEGACY_CATEGORY_LABELS } from "../../data/taxonomy";
import { articleSlug, getLegacyEntries } from "../../lib/articles";

export async function getStaticPaths() {
  const entries = await getLegacyEntries();
  return entries.map((entry) => ({
    params: { slug: articleSlug(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const category =
  LEGACY_CATEGORY_LABELS[
    entry.data.category as keyof typeof LEGACY_CATEGORY_LABELS
  ] ?? "Pool archive";
const canonicalPath = `/guides/${articleSlug(entry.id)}/`;
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  noindex
>
  <Breadcrumbs
    items={[
      { href: "/", label: "Home" },
      { label: "Legacy pool archive" },
      { label: entry.data.title },
    ]}
  />

  <article class="article-page">
    <header class="article-header">
      <div class="article-header-inner">
        <p class="article-kicker">Legacy archive / {category}</p>
        <h1>{entry.data.title}</h1>
        <p class="article-deck">{entry.data.description}</p>
        <p class="article-byline">
          <span>Archived editorial</span>
          <span>{formatDate(entry.data.date)}</span>
          <span>{entry.data.readingTime}</span>
        </p>
      </div>
    </header>

    <div class="container article-layout">
      <article class="article-content prose">
        <p class="article-disclosure">
          This page is retained for URL continuity. It is excluded from the
          current home-appliance library and will not receive new updates.
        </p>
        <Content />
      </article>

      {
        toc.length > 0 && (
          <aside class="article-side">
            <nav class="article-toc" aria-label="In this archived guide">
              <p>In this guide</p>
              <ol>
                {toc.map((heading) => (
                  <li class:list={[heading.depth === 3 ? "toc-subitem" : ""]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>
