---
import ArticleFeature from "../../components/ArticleFeature.astro";
import ArticleGrid from "../../components/ArticleGrid.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SECTIONS, type SectionKey } from "../../data/blog";
import { SITE } from "../../data/site";
import { getAllArticles } from "../../lib/articles";

const articles = await getAllArticles();
const featured = articles.find((article) => article.featured) ?? articles[0];
const sectionKeys = Object.keys(SECTIONS) as SectionKey[];
const grouped = sectionKeys.map((key) => ({
  key,
  ...SECTIONS[key],
  articles: articles.filter(
    (article) => article.category === key && article.id !== featured.id,
  ),
}));

const title = "All pool guides";
const description =
  "Browse every Trusted Buyer Lab guide to robotic pool cleaners, pool care, and smarter equipment buying decisions.";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE.url}/guides/#collection`,
  url: `${SITE.url}/guides/`,
  name: title,
  description,
  inLanguage: "en",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE.url}${article.href}`,
      name: article.title,
    })),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/guides/"
  schema={schema}
>
  <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "All guides" }]} />

  <header class="page-intro">
    <div class="container page-intro-grid">
      <div>
        <p class="eyebrow">The full library</p>
        <h1>Every guide, organized by the decision in front of you.</h1>
      </div>
      <div class="page-intro-aside">
        <p>
          {articles.length} research-led articles across pool robots, ongoing
          pool care, and buying strategy. New material is added without
          changing the structure of the site.
        </p>
        <nav class="topic-links" aria-label="Article sections">
          {sectionKeys.map((key) => <a href={SECTIONS[key].href}>{SECTIONS[key].label}</a>)}
        </nav>
      </div>
    </div>
  </header>

  <section class="section paper">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Start here</p>
          <h2>The current lead guide</h2>
        </div>
        <p>
          The most complete comparison in the library, selected as the best
          entry point for a pool robot purchase.
        </p>
      </div>
      <ArticleFeature article={featured} priority />
    </div>
  </section>

  {
    grouped.map((section, sectionIndex) => (
      <section
        class:list={["section", sectionIndex % 2 === 0 ? "mist" : ""]}
        id={section.key}
      >
        <div class="container">
          <div class="section-header">
            <div>
              <p class="eyebrow">{section.eyebrow}</p>
              <h2>{section.label}</h2>
            </div>
            <div>
              <p>{section.description}</p>
              <a class="text-link section-header-link" href={section.href}>
                Open the {section.label.toLowerCase()} section
              </a>
            </div>
          </div>
          <ArticleGrid
            articles={section.articles}
            emptyMessage={`The lead guide is currently the only article in ${section.label}.`}
          />
        </div>
      </section>
    ))
  }
</BaseLayout>
