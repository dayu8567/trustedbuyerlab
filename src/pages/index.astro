---
import { Image } from "astro:assets";
import ArticleGrid from "../components/ArticleGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SECTIONS, type SectionKey } from "../data/blog";
import { SITE } from "../data/site";
import {
  getAllArticles,
  getArticleCounts,
} from "../lib/articles";

const articles = await getAllArticles();
const counts = await getArticleCounts();
const featured = articles.find((article) => article.featured) ?? articles[0];
const latest = articles
  .filter((article) => article.id !== featured.id)
  .slice(0, 6);
const sectionKeys = Object.keys(SECTIONS) as SectionKey[];
const totalCount = articles.length;

const title = "Pool care and buying guides";
const description =
  "Independent research, practical buying guides, and straightforward pool care advice for smarter ownership decisions.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      description,
      inLanguage: "en",
    },
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      url: `${SITE.url}/`,
      description: SITE.description,
    },
    {
      "@type": "CollectionPage",
      "@id": `${SITE.url}/#collection`,
      url: `${SITE.url}/`,
      name: title,
      description,
      inLanguage: "en",
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: articles.length,
        itemListElement: articles.map((article, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `${SITE.url}${article.href}`,
          name: article.title,
        })),
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  schema={schema}
>
  <section class="blog-hero">
    <div class="container blog-hero-grid">
      <div class="blog-hero-copy">
        <p class="eyebrow">Independent pool research</p>
        <h1>Pool care advice built around better decisions.</h1>
        <p class="hero-lede">
          Plain-spoken buying guides, model comparisons, and maintenance
          explainers for pool owners who want the useful details without the
          sales language.
        </p>
        <div class="hero-meta">
          <span class="meta-item"><span class="meta-dot"></span>{totalCount} published guides</span>
          <span class="meta-item"><span class="meta-dot"></span>3 focused sections</span>
        </div>
        <div class="hero-meta">
          <a class="button" href="/guides/">Browse the full library</a>
          <a class="button secondary" href="/about/">How we research</a>
        </div>
      </div>

      <article class="home-feature">
        <a class="home-feature-media" href={featured.href} tabindex="-1" aria-hidden="true">
          <Image
            src={featured.image}
            alt={featured.imageAlt}
            widths={[560, 820, 1120]}
            sizes="(max-width: 860px) 100vw, 46vw"
            format="webp"
            quality={72}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </a>
        <div class="home-feature-body">
          <p class="article-kicker">Editor's starting point</p>
          <h2><a href={featured.href}>{featured.title}</a></h2>
          <p>{featured.description}</p>
          <p class="article-meta">
            <span>{SECTIONS[featured.category].label}</span>
            <span>{featured.dateLabel}</span>
            <span>{featured.readingTime}</span>
          </p>
        </div>
      </article>
    </div>
  </section>

  <nav class="section-index" aria-label="Browse by topic">
    <div class="container section-index-grid">
      {
        sectionKeys.map((key, index) => (
          <a class="section-index-item" href={SECTIONS[key].href}>
            <span class="section-index-number">{String(index + 1).padStart(2, "0")}</span>
            <span class="section-index-copy">
              <strong>{SECTIONS[key].label}</strong>
              <span>{SECTIONS[key].description}</span>
            </span>
            <span class="section-index-count">{counts[key]} guides</span>
          </a>
        ))
      }
    </div>
  </nav>

  <section class="section paper">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Latest from the lab</p>
          <h2>New guides and field notes</h2>
        </div>
        <div>
          <p>
            Start with the newest research, then follow a section for the
            decisions closest to your pool.
          </p>
          <a class="text-link section-header-link" href="/guides/">View every guide</a>
        </div>
      </div>
      <ArticleGrid articles={latest} />
    </div>
  </section>

  <section class="section">
    <div class="container editorial-band">
      <div>
        <p class="eyebrow">What belongs here</p>
        <h2>A pool library, not a single product page.</h2>
      </div>
      <div class="editorial-band-copy">
        <p>
          The library follows the questions that come before and after a
          purchase: which cleaner fits the pool, what each specification
          changes, and how to keep the equipment working without adding a
          second maintenance project.
        </p>
        <a class="button secondary" href="/about/">Read our editorial approach</a>
      </div>
    </div>
  </section>
</BaseLayout>
