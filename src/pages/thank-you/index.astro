---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You"
  description="Your request has been received. Continue to the Trusted Buyer Lab home appliance library."
  canonicalPath="/thank-you/"
  noindex
>
  <section class="thank-you">
    <div class="container">
      <p class="eyebrow">Request received</p>
      <h1>Your next appliance guide is ready.</h1>
      <p>
        Continue with the latest kitchen, laundry, cleaning, air, or
        smart-home research in the library.
      </p>
      <div class="verdict-actions center-actions">
        <a class="button" href="/articles/">Browse appliance articles</a>
        <a class="button secondary" href="/deals/">See price briefs</a>
      </div>
    </div>
  </section>
</BaseLayout>
