---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You"
  description="Your request has been received. Continue to the Trusted Buyer Lab pool robot guides."
  canonicalPath="/thank-you/"
  noindex
>
  <section class="thank-you">
    <div class="container">
      <p class="eyebrow">Request received</p>
      <h1>Your next comparison is ready.</h1>
      <p>
        Continue with the full cordless pool robot guide or return to the
        Beatbot Sora lineup.
      </p>
      <div class="verdict-actions center-actions">
        <a class="button" href="/best-cordless-robotic-pool-cleaners/">
          Read the 2026 comparison
        </a>
        <a class="button secondary" href="/">Back to the Sora guide</a>
      </div>
    </div>
  </section>
</BaseLayout>
